PORT=4000

# MongoDB Atlas connection string (mongodb+srv://user:password@cluster.mongodb.net/dbname)
# La connexion est non-bloquante : l'API fonctionne (sans persistance) meme si ceci est absent/invalide.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/competencymentor

# Binaire Python du venv bloc1_ml (pandas/scikit-learn/joblib installes)
PYTHON_BIN=../bloc1_ml/venv/bin/python3

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
